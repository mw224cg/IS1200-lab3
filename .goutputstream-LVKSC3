int mytime = 0x5957;
char textstring[] = "text, more text, and even more text!";

#define LEDS ((volatile unsigned int*) 0x04000000)

void set_leds(unsigned int led_mask){
  led_mask = led_mask & 0x3FF; //0x3FF = 11 1111 1111
  *LEDS = led_mask;
}

